@inproceedings{10.1145/3638837.3638883,
author = {Huang, Yong Xuan and Wang, Kung Chun and Ke, Bi Shun},
title = {Accelerating 5G Service-Based Architecture with Ebpf},
year = {2024},
isbn = {9798400709265},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3638837.3638883},
doi = {10.1145/3638837.3638883},
abstract = {Service-Based Architecture (SBA) serves as a foundational methodology for 5G core networks, as delineated by the 3rd Generation Partnership Project (3GPP). This modular approach segments the 5G Core Network into discrete, functionally autonomous Network Functions (NFs), deployed via either virtual machines or container technologies. The efficacy of the SBA execution platform significantly impacts the service capabilities of these NFs. In this study, we present an enhanced architecture that employs extended Berkeley Packet Filter (eBPF) and eXpress Data Path (XDP) technologies to fine-tune the network, security, service, and scheduling aspects within a Kubernetes framework. Additionally, eBPF’s monitoring and packet control features augment the service capabilities of 5G components, thereby improving encrypted data transmission. eBPF’s real-time monitoring aids the scheduler in making nuanced decisions, while an eBPF-driven load balancer ensures equitable service distribution. Comprehensive testing reveals that the enhanced architecture increases transmission efficiency by 17%, reduces average latency by 43%, and alleviates latency anomalies compared to conventional 5G NF platforms. It also enhances the inherent connectivity of 5G NFs by approximately 15%. For encryption-reliant applications, the architecture achieves a 17% performance gain in latency, transmission, and connectivity, while its scheduling and service balancing capabilities demonstrate a roughly 19% performance enhancement.},
booktitle = {Proceedings of the 2023 12th International Conference on Networks, Communication and Computing},
pages = {200–209},
numpages = {10},
keywords = {5G Core Network, Virtual Network Acceleration, eBPF/XDP},
location = {Osaka, Japan},
series = {ICNCC '23}
}

@inproceedings{10.1145/3703935.3704060,
author = {Chun, Ruifeng and Zhu, Guohui and Wang, Xiaomin and Liang, Zhen},
title = {Network slicing resource allocation based on deep reinforcement learning in flexible networks},
year = {2025},
isbn = {9798400717178},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3703935.3704060},
doi = {10.1145/3703935.3704060},
abstract = {In order to ensure the quality of experience (QoE) of users and meet the differentiated needs of different applications at the same time, the dynamic and flexible allocation of resources in wireless networks is critical. Aiming at the fluctuation of network traffic and the rapid change of network state, this paper proposes a resource allocation problem for network slicing in flexible networks with the assistance of Dual Connectivity (DC). Considering the non-convexity and combination characteristics of the resource allocation problem, a Randomly Connected Long Short-Term Memory-Dueling Double Deep Q-Network (RCLSTM-D3QN) is proposed to solve this problem, aiming to improve the overall network utility while ensuring the QoE. Simulation results show that the proposed algorithm can effectively reduce the impact of network environment fluctuations on slice resource management in dense traffic scenarios by sensing network performance changes in advance, and maximize the total system utility while ensuring user QoE. Compared with LSTM-A2C and D3QN, the overall network utility of the proposed algorithm is increased by 3.8% and 5.18%, respectively. In addition, compared with the DC-free algorithm, the network utility of the proposed algorithm is improved by 8.3%.},
booktitle = {Proceedings of the 2024 7th International Conference on Artificial Intelligence and Pattern Recognition},
pages = {972–979},
numpages = {8},
keywords = {Network slicing, Resource allocation, Deep reinforcement learning, Dueling double deep Q-network(D3QN)},
location = {
},
series = {AIPR '24}
}

@inproceedings{10.1145/3626232.3653253,
author = {GholipourChoubeh, Mahmood and Kermabon-Bobinnec, Hugo and Majumdar, Suryadipta and Jarraya, Yosr and Wang, Lingyu and Nour, Boubakr and Pourzandi, Makan},
title = {CCSM: Building Cross-Cluster Security Models for Edge-Core Environments Involving Multiple Kubernetes Clusters},
year = {2024},
isbn = {9798400704215},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3626232.3653253},
doi = {10.1145/3626232.3653253},
abstract = {With the emergence of 5G networks and their large scale applications such as IoT and autonomous vehicles, telecom operators are increasingly offloading the computation closer to customers (i.e., on the edge). Such edge-core environments usually involve multiple Kubernetes clusters potentially owned by different providers. Confidentiality concerns could prevent those providers from sharing data freely with each other, which makes it challenging to perform common security tasks such as security verification across different clusters. In this work, we propose a solution for building cross-cluster security models to enable various security analyses, while preserving confidentiality for each cluster. We design a six-step methodology to model both the cross-cluster communication and cross-cluster event dependency, and we apply those models to different security use cases. We implement our solution based on a 5G edge-core environment that involves multiple Kubernetes clusters, and our experimental results demonstrate its efficiency (e.g., less than 8 seconds of processing time for a model with 3,600 edges and nodes) and accuracy (e.g., more than 96% for cross-cluster event prediction).},
booktitle = {Proceedings of the Fourteenth ACM Conference on Data and Application Security and Privacy},
pages = {79–90},
numpages = {12},
keywords = {5g, cloud computing security, kubernetes, security model},
location = {Porto, Portugal},
series = {CODASPY '24}
}

