@inproceedings{10.1145/3551662.3561200,
author = {Zhou, Jianshan and Liu, Shiyi and Han, Xu and Tian, Daxin and Leung, Victor C.M.},
title = {Ultra-Reliable Computation Offloading for Aerial-Ground Cooperative Vehicular Networks with Joint Mobility Optimization and Transmission Scheduling},
year = {2022},
