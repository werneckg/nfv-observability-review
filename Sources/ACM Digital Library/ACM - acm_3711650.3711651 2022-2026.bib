author = {Kaur, Amritpal and Singh, Sarbjeet},
title = {A Survey of Streaming Protocols for Video Transmission},
year = {2022},
isbn = {9781450387637},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3484824.3484892},
