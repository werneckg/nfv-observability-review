@inproceedings{10.1145/3659994.3660315,
author = {Dazzi, Patrizio and Ferrucci, Luca and Danelutto, Marco and Tserpes, Konstantinos and Makris, Antonios and Theodoropoulos, Theodoros and Massa, Jacopo and Carlini, Emanuele and Mordacchini, Matteo},
title = {Urgent Edge Computing},
year = {2024},
