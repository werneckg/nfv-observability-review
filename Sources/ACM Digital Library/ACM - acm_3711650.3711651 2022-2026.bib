@inproceedings{3581644.3581685,
author = {Dietz, Katharina and Seufert, Michael and Ho\ss{}feld, Tobias},
title = {Comparing Traditional and GAN-Based Approaches for the Synthesis of Wide Area Network Topologies},
year = {2023},
isbn = {9783903176515},
publisher = {International Federation for Information Processing},
address = {Laxenburg, AUT},
abstract = {Wide Area Network (WAN) research benefits from the availability of realistic network topologies, e. g., as input to simulations, emulators, or testbeds. With the rise of Machine Learning (ML) and particularly Deep Learning (DL) methods, this demand for topologies, which can be used as training data, is greater than ever. However, public datasets are limited, thus, it is promising to generate synthetic graphs with realistic properties based on real topologies for the augmentation of existing data sets. As the generation of synthetic graphs has been in the focus of researchers of various applications fields since several decades, we have a variety of traditional model-dependent and model-independent graph generators at hand, as well as DL-based approaches, such as Generative Adversarial Networks (GANs). In this work, we adapt and evaluate these existing generators for the WAN use case, i. e., for generating synthetic WANs with realistic geographical distances between nodes. Moreover, we investigate a hierarchical graph synthesis approach, which divides the synthesis into local clusters. Finally, we compare the similarity of synthetic and real WAN topologies and discuss the suitability of the generators for data augmentation in the WAN use case.},
booktitle = {Proceedings of the 18th International Conference on Network and Service Management},
articleno = {33},
numpages = {9},
keywords = {generative adversarial networks (GAN), graph generation, graph synthesis, network topology, spectral clustering, wide area networks (WAN)},
location = {Thessaloniki, Greece},
series = {CNSM '22}
}

@inproceedings{10.1145/3555050.3569117,
author = {Osi\'{n}ski, Tomasz and Palim\k{a}ka, Jan and Kossakowski, Mateusz and Tran, Fr\'{e}d\'{e}ric Dang and Bonfoh, El-Fadel and Tarasiuk, Halina},
title = {A novel programmable software datapath for software-defined networking},
year = {2022},
isbn = {9781450395083},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3555050.3569117},
doi = {10.1145/3555050.3569117},
abstract = {This paper introduces NIKSS (Native In-Kernel SDN Switch), a novel programmable software switch for Software-Defined Networking. NIKSS leverages P4 as a high-level programming abstraction, Portable Switch Architecture (PSA) as a fully-featured P4 forwarding model and eBPF as a packet processing engine. The main component of NIKSS is the PSA-eBPF compiler that translates P4 programs into code that runs inside the eBPF execution environment. However, enabling a high degree of programmability for data planes without sacrificing performance or operability is a challenge. Therefore, NIKSS provides two alternative designs of generated code, with different trade-offs between supported PSA features and achieved performance. We demonstrate that NIKSS can be used successfully as a P4 software switch, with an acceptable performance gap compared to native eBPF programming. We also provide an extensive performance evaluation, proving that NIKSS might be a viable alternative to existing software switches.},
booktitle = {Proceedings of the 18th International Conference on Emerging Networking EXperiments and Technologies},
pages = {245–260},
numpages = {16},
location = {Roma, Italy},
series = {CoNEXT '22}
}

@inproceedings{10.1145/3807246.3807326,
author = {Wang, Wenhao and Zhang, Wenzheng},
title = {Research on Multi-Agent Deep Determination Strategies for Task Computation Offloading in Space-Ground Integrated Networks},
year = {2026},
isbn = {9798400723537},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3807246.3807326},
doi = {10.1145/3807246.3807326},
abstract = {Satellite-ground integrated networks leverage their advantages of wide coverage, high capacity, and flexible networking to effectively enhance overall network resource utilization, providing users with comprehensive computing services and diverse access methods. Addressing challenges such as high-speed satellite movement, time-varying satellite-ground channels, diverse terminal computing tasks, and random user resource requests. A satellite-ground network model is constructed by jointly configuring edge servers on both base station and satellite sides. First, delay, queueing, and energy models for task execution on the satellite side are established, and a knapsack model is proposed to allocate computational resources to tasks. Subsequently, joint optimization of task offloading and satellite computational resource allocation is performed to minimize the overall computational energy consumption of the satellite-ground integrated network system while satisfying task latency constraints, Also, the Multi-Agent Deep Deterministic Policy Gradient (MADDPG) algorithm is employed to optimize the task offloading process. Simulation results demonstrate that compared to existing algorithms, this approach meets task delay requirements while reducing overall system energy consumption.},
booktitle = {Proceedings of the 2026 International Conference on Artificial Intelligence and Control},
pages = {511–517},
numpages = {7},
keywords = {Computational energy consumption, Computational offloading, MADDPG, Satellite-ground integrated network, Task offloading},
location = {
},
series = {CAIC '26}
}

@inproceedings{10.1145/3546096.3546111,
author = {Wen, Zhixin and Pacherkar, Harsh Sanjay and Yan, Guanhua},
title = {VET5G: A Virtual End-to-End Testbed for 5G Network Security Experimentation},
year = {2022},
isbn = {9781450396844},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3546096.3546111},
doi = {10.1145/3546096.3546111},
abstract = {As 5G networks are gradually rolled out worldwide, it is important to ensure that their network infrastructures are resilient against malicious attacks. This work presents VET5G, a new virtual end-to-end testbed for 5G network security research experiments or training activities such as Capture-The-Flag competitions. The distinguishing features of VET5G include a home-grown 5G core network emulator written in Rust to ensure memory and thread safety, integration of OpenAirInterface’s Radio Access Network emulator and the official Android emulator to achieve full end-to-end 5G network emulation, inclusion of a reference P4 software switch to assist with prototyping of defense mechanisms for 5G data planes, implementation of Python APIs for easy 5G network experimentation, and adoption of JupyterHub to support multi-user experimentation. In our experiments we demonstrate how to use VET5G for two attack scenarios in 5G networks as well as its performance when it is used in a 5G hacking project for a Mobile Systems Security course.},
booktitle = {Proceedings of the 15th Workshop on Cyber Security Experimentation and Test},
pages = {19–29},
numpages = {11},
keywords = {5G networks, Rust, programmable switch, security testbed},
location = {Virtual, CA, USA},
series = {CSET '22}
}

