@article{10.1109/TNET.2021.3137418,
author = {Tu, Huaqing and Zhao, Gongming and Xu, Hongli and Zhao, Yangming and Zhai, Yutong},
title = {A Robustness-Aware Real-Time SFC Routing Update Scheme in Multi-Tenant Clouds},
year = {2022},
issue_date = {June 2022},
publisher = {IEEE Press},
volume = {30},
number = {3},
issn = {1063-6692},
url = {https://doi.org/10.1109/TNET.2021.3137418},
doi = {10.1109/tnet.2021.3137418},
abstract = {In multi-tenant clouds, requests need to traverse a set of network functions (NFs) in a specific order, referred to as a service function chain (SFC), for security and business logic issues. Due to workload dynamics, the central controller of a multi-tenant cloud needs to frequently update the SFC routing, so as to optimize various network performance, such as load balancing. To achieve effective SFC routing update, we should consider two critical requirements: &lt;italic&gt;system robustness&lt;/italic&gt; and &lt;italic&gt;real-time update&lt;/italic&gt;. Without considering these two requirements, prior works either result in fragile clouds or suffer from large update delay. In this paper, we propose a robustness-aware real-time SFC routing update (R&lt;sup&gt;3&lt;/sup&gt;-UA) scheme which takes both requirements into consideration. R&lt;sup&gt;3&lt;/sup&gt;-UA pursues robustness-aware real-time routing update through two phases: robust NF instance assignment update and real-time SFC routing update. Two algorithms with bounded approximation ratios are proposed for these two phases, respectively. We implement R&lt;sup&gt;3&lt;/sup&gt;-UA on a real testbed. Both small-scale experimental results and large-scale simulation results show the superior performance of R&lt;sup&gt;3&lt;/sup&gt;-UA compared with other alternatives.},
journal = {IEEE/ACM Trans. Netw.},
month = jan,
pages = {1230–1244},
numpages = {15}
}

