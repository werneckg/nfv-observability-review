@article{10.1145/3486221,
author = {Costa, Breno and Bachiega, Joao and de Carvalho, Leonardo Rebou\c{c}as and Araujo, Aleteia P. F.},
title = {Orchestration in Fog Computing: A Comprehensive Survey},
year = {2022},
issue_date = {February 2023},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {55},
number = {2},
issn = {0360-0300},
url = {https://doi.org/10.1145/3486221},
doi = {10.1145/3486221},
abstract = {Fog computing is a paradigm that brings computational resources and services to the network edge in the vicinity of user devices, lowering latency and connecting with cloud computing resources. Unlike cloud computing, fog resources are based on constrained and heterogeneous nodes whose connectivity can be unstable. In this complex scenario, there is a need to define and implement orchestration processes to ensure that applications and services can be provided, considering the settled agreements. Although some publications have dealt with orchestration in fog computing, there are still some diverse definitions and functional intersection with other areas, such as resource management and monitoring. This article presents a systematic review of the literature with focus on orchestration in fog computing. A generic architecture of fog orchestration is presented, created from the consolidation of the analyzed proposals, bringing to light the essential functionalities addressed in the literature. This work also highlights the main challenges and open research questions.},
journal = {ACM Comput. Surv.},
month = jan,
articleno = {29},
numpages = {34},
keywords = {Fog computing, orchestration, monitoring, resource management}
}

@article{10.1145/3818682,
author = {Darbandeh, Foroozan and Asghar, Muhammad Rizwan and Chen, Liqun},
title = {Cyber Resilience in IoT Networks Revisited: Frameworks, Mechanisms, and Future Directions},
year = {2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
issn = {0360-0300},
url = {https://doi.org/10.1145/3818682},
doi = {10.1145/3818682},
abstract = {The rising number of cyber intrusions targeting IoT networks—widely deployed in critical domains such as smart transportation, healthcare, and urban infrastructure—highlights the limitations of traditional security approaches in countering evolving threats. As cyber attackers become more sophisticated and adaptive, they can outsmart traditional intrusion detection and prevention systems, compromising the integrity and availability of these critical networks. Recognising the inevitability of cyber attacks and their potentially severe impacts, researchers have shifted from purely preventive security measures to a resilience-focused approach that prioritises rapid response and recovery to minimise disruptions. A comprehensive and standardised framework, developed based on the specific and unique requirements of IoT networks, can serve as a theoretical and practical foundation for designing and implementing effective and resilient mechanisms. This survey examines the concept of cyber resilience in IoT networks, with a focus on both framework development and the critique of proposed mechanisms. It introduces a customised cyber resilience framework tailored for IoT networks, based on the Cyber Resilience Framework by the National Institute of Standards and Technology (NIST). Also, it provides a roadmap and structured development process to facilitate the implementation of resilience mechanisms. The survey categorises existing cyber resilience mechanisms for IoT networks based on the techniques and approaches used and evaluates their effectiveness in achieving cyber resilience goals using the customised framework.},
note = {Just Accepted},
journal = {ACM Comput. Surv.},
month = may,
keywords = {Internet of Things, Cyber Resilience, Cyber Security, NIST Cyber Resilience Framework, Risk Management, Cyber Resilience Metrics.}
}

@article{10.1145/3744555,
author = {He, Haoxin and Fei, Shufan and Yan, Zheng},
title = {Advancing 5G Security and Privacy with AI: A Survey},
year = {2025},
issue_date = {January 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {58},
number = {2},
issn = {0360-0300},
url = {https://doi.org/10.1145/3744555},
doi = {10.1145/3744555},
abstract = {With the global deployment of the fifth-generation (5G) mobile technology, a new era characterized by ultra-high data speeds, ultra-low latency, and massive connectivity has emerged. However, these advancements also introduce new security and privacy challenges. The integration of new technologies in 5G has fundamentally altered the network structure, rendering traditional security methods inadequate. Artificial intelligence (AI), with its advanced data analysis and pattern recognition capabilities, is a promising solution to enhance security and privacy in 5G networks. While existing surveys discuss AI applications for 5G, there is a lack of a comprehensive survey on the performance of various AI-based solutions for 5G security and privacy. This article aims to fill this gap by providing an in-depth review of the latest advancements in AI for 5G security and privacy. We begin with an overview of the security and privacy challenges in 5G networks, including potential vulnerabilities, attack vectors, and privacy issues. We then propose a set of evaluation criteria for assessing various AI-based solutions. Following this, we present a taxonomy of AI-based security and privacy solutions and review the latest advancements. Finally, we identify open issues and propose future directions for utilizing AI to enhance 5G security and privacy.},
journal = {ACM Comput. Surv.},
month = sep,
articleno = {47},
numpages = {36},
keywords = {5G security, privacy, AI, machine learning}
}

