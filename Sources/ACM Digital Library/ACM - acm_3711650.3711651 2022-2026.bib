@inproceedings{10.1145/3685767.3685775,
author = {Cai, Xuhui and Zhao, Zhihong and Li, Yingqi and Chao, Lumeng},
title = {A SAAS Application Based on Log Anomaly Detection},
year = {2024},
isbn = {9798400709609},
publisher = {Association for Computing Machinery},
