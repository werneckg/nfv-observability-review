@inproceedings{10.1145/3558819.3558842,
author = {He, Gaoyao and Hu, Bin and Ma, Wenjie and Lu, Yi and Wu, Xuhui},
title = {Research and Development of Intelligent Auxiliary Frame System Based on Remote Audio and Video},
year = {2022},
isbn = {9781450397414},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3558819.3558842},
doi = {10.1145/3558819.3558842},
abstract = {This paper designs and develops a J2EE-based network remote real-time consultation audio and video module. The system uses the standard H-264 video compression technology as the core algorithm of the system, combined with cameras, pickups and wireless transmission modules to achieve data collection, processing and network transmission functions. Through real-time analysis of the client terminal operation trajectory and interface operation duration, the system reminds service personnel to connect to the terminal client and provides active audio and video remote services. The system relies on low-latency audio and video live broadcast technology and remote desktop technology, and the virtual desks in the background can assist or replace customers to complete related terminal operations. The simulation test analysis shows that the system can effectively compress the image space under the premise of ensuring the image quality, and has better network adaptability and effectiveness.},
