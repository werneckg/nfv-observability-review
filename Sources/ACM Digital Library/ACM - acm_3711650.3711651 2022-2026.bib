@inproceedings{10.1145/3766557.3766566,
author = {Yu, Zhixiong and Jiang, Xin},
title = {An AI Career Educational Revolution Driven by Project-based Teaching},
year = {2025},
isbn = {9798400721168},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3766557.3766566},
doi = {10.1145/3766557.3766566},
abstract = {In the era driven by AI large models, this study addresses the critical mismatch between vocational education and evolving industry demands, proposing a project-based teaching paradigm for cultivating integrated “AI + Network Engineering” talents. Through a systematic analysis of the intelligent transformation trajectory for network engineers, we design a three-stage training framework: basic capability development, AI reasoning enhancement, and project-based teaching practice. Leveraging large models, we dynamically generate personalized learning paths and optimize training efficiency via virtual simulation and industry-education data integration. A multi-scenario curriculum system is developed, covering intelligent operation and maintenance, natural language configuration, and security attack-defense simulation. This creates a dynamic closed loop of “demand analysis-teaching implementation-employment matching,” aiming to drive the transformation of vocational education toward intelligence and practice orientation. Empirical results demonstrate that this framework, through deep integration of AI large models and education, provides a scalable AI talent cultivation model for vocational colleges, fostering synergistic development of educational equity and industrial upgrading.},
booktitle = {Proceedings of the 2025 International Conference on Educational Technology and Artificial Intelligence},
pages = {50–55},
numpages = {6},
keywords = {AI large models, Artificial intelligence, Curriculum reform, Project-based teaching, Vocational education},
location = {
},
series = {ETAIC '25}
}

