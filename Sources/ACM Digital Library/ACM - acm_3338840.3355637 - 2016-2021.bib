abstract = {In this article we describe the discussion and conclusions of the "Roundtable on Real-Time Communications Research: 5G and Real-Time Communications --- Topics for Research" held at the Illinois Institute of Technology's Real-Time Communications Conference and Expo, co-located with the IPT-Comm Conference, October 5--8, 2015.},
