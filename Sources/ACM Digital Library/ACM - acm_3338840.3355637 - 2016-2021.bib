@inproceedings{10.1145/3083181.3083185,
author = {Ravindran, Kaliappa and Iannelli, Michael},
title = {Replicated Sensing in Wireless-Networked Smart Systems with Cloud-assisted Support},
year = {2017},
isbn = {9781450350518},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3083181.3083185},
doi = {10.1145/3083181.3083185},
abstract = {Existing works on IoT deal with computing and communications as incorporated in networked objects. These are handled in the D-to-D and M-to-M communication layers over wireless networks. We believe that a decision-making functionality to enable system-wide control of sensor accuracy is necessary to make the transition from an IoT to a smart system amenable for infusion in data-intensive applications. Our paper focuses on the system-level mechanisms needed to make this transition. A key element of our approach is to deal with data fuzziness and system uncertainty with replicated and distributed sensing techniques. These are augmented by a system-wide mechanism to realize virtualized sensors with controllable accuracy.},
booktitle = {Proceedings of the ACM Workshop on Distributed Information Processing in Wireless Networks},
articleno = {3},
numpages = {6},
keywords = {Sensor Replication Systems, Sensor Faults &amp; Data Errors, Replica Voting, Large-dimensional Data, Distributed Control &amp; Management, Adaptive Sensing},
location = {Chennai, India},
series = {DIPWN'17}
}

